# Copy this file to `.env` and fill in values locally. `.env` is gitignored: never commit it.
# Do not insert a real API key or secret into this example file.

# Anthropic API key for live LLM execution (Claude models).
# Fill this key locally in your .env file only when live inference is authorized and funded.
# Tests and offline dry-runs (FakeLLMClient) do not require this key.
ANTHROPIC_API_KEY=

# Optional: where Hugging Face caches models/datasets (useful on small disks or Colab).
# HF_HOME=
