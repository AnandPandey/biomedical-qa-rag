# Copy this file to `.env` and fill in values locally. `.env` is gitignored: never commit it.
# Nothing in Phase 1 reads these variables; CI never needs them.

# LLM provider and model are not decided yet (see docs/interfaces.md, "LLM client").
# Use the environment variable name your provider's SDK expects for the key.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Optional: where Hugging Face caches models/datasets (useful on small disks or Colab).
# HF_HOME=
